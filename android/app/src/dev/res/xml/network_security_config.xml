<?xml version="1.0" encoding="utf-8"?>
<!--
    DEV FLAVOUR ONLY. This file lives under src/dev/, so it is compiled into the
    development build and cannot reach the production one: src/prod/ has no
    manifest overlay and therefore no networkSecurityConfig at all.

    It exists so a developer can run the app against `supabase start` on their
    own machine, which serves plain HTTP. Two hosts, named individually rather
    than a blanket cleartextTrafficPermitted="true":

      10.0.2.2   the host machine as seen from the Android emulator
      localhost  the host machine when reached over `adb reverse`

    Every other destination, including the development Supabase project once one
    exists, still requires TLS.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
